# Derived caches, rebuilt by gnn/data.py. The datasets in data/ are the artifact;
# these are not. Pattern, not a literal name: an earlier literal `gnn/graphs.npz`
# failed to catch `gnn/graphs_allobench.npz` and a half-written 52 MB file got
# committed while it was still being appended to.
gnn/graphs*.npz

# ASD-derived annotations: upstream deliberately does not redistribute these,
# and neither do we. Rebuild with scripts/build_allobench.sh.
data/targets_allobench/
external/allobench-pipeline/AlloBench.csv
external/allobench-pipeline/data/
external/allobench-pipeline/metadata/manifest.built.json
external/allobench-pipeline/metadata/allobench_filtered.json
